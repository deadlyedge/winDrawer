<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\assets\drawer.icon.4.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- <SelfContained>true</SelfContained> -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SunnyUI" Version="3.9.8" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Drawer-settings.toml">
      <LogicalName>winDrawer.DefaultSettings.toml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\fonts\Lobster-Regular.ttf">
      <LogicalName>winDrawer.Branding.Lobster-Regular.ttf</LogicalName>
    </EmbeddedResource>
    <Content Remove="..\assets\fonts\Lobster-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="reference\**\*.cs" />
  </ItemGroup>


</Project>