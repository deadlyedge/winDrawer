<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- <SelfContained>true</SelfContained> -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SunnyUI" Version="3.8.8" />
    <PackageReference Include="Tomlyn" Version="0.11.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Drawer-settings.toml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="assets\drawer.icon.4.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="assets\fonts\Lobster-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- <ItemGroup>
    Ensure assets (including drawer.icon.4.ico) are copied to the output so the app can load
    them at runtime
  </ItemGroup> -->

  <ItemGroup>
    <Compile Remove="reference\**\*.cs" />
  </ItemGroup>


</Project>